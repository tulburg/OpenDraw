{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["node", "bun"]
  },
  "include": ["src", "electron", "shared", "bin", "scripts", "tests", "vite.config.ts"],
  "exclude": ["open-pencil", "node_modules", "dist", "dist-electron"]
}
