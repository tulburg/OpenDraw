{
  "name": "opendraw",
  "productName": "OpenDraw",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "vite build && bun scripts/build-electron.ts",
    "start": "bun run build && electron .",
    "dist": "bun run build && electron-builder",
    "typecheck": "tsc --noEmit",
    "test:launch": "bun run build && bun tests/launch.test.ts",
    "test:engine": "bun run build && bun tests/engine.test.ts",
    "test:mcp": "bun run build && bun tests/mcp.test.ts",
    "test": "bun run build && bun tests/launch.test.ts && bun tests/engine.test.ts && bun tests/mcp.test.ts && bun tests/write.test.ts && bun tests/canvas.test.ts && bun tests/styles.test.ts && bun tests/text.test.ts && bun tests/tools.test.ts && bun tests/handles.test.ts && bun tests/interactions.test.ts && bun tests/resources.test.ts && bun tests/pages.test.ts && bun tests/tokens.test.ts && bun tests/export.test.ts && bun tests/comments.test.ts && bun tests/helpers.test.ts && bun tests/layers.test.ts && bun tests/arrange.test.ts && bun tests/images.test.ts",
    "test:write": "bun run build && bun tests/write.test.ts",
    "test:canvas": "bun run build && bun tests/canvas.test.ts",
    "test:styles": "bun run build && bun tests/styles.test.ts",
    "test:text": "bun run build && bun tests/text.test.ts",
    "test:tools": "bun run build && bun tests/tools.test.ts",
    "test:handles": "bun run build && bun tests/handles.test.ts",
    "test:interactions": "bun run build && bun tests/interactions.test.ts",
    "test:resources": "bun run build && bun tests/resources.test.ts",
    "test:pages": "bun run build && bun tests/pages.test.ts",
    "test:tokens": "bun run build && bun tests/tokens.test.ts",
    "test:export": "bun run build && bun tests/export.test.ts && bun tests/comments.test.ts",
    "test:comments": "bun run build && bun tests/comments.test.ts",
    "test:helpers": "bun run build && bun tests/helpers.test.ts",
    "test:layers": "bun run build && bun tests/layers.test.ts",
    "test:arrange": "bun run build && bun tests/arrange.test.ts",
    "test:perf": "bun run build && bun tests/perf.test.ts",
    "test:images": "bun run build && bun tests/images.test.ts",
    "test:package": "bun tests/package.test.ts"
  },
  "trustedDependencies": [
    "electron"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "bin": {
    "opendraw-mcp": "dist-electron/opendraw-mcp.mjs"
  },
  "build": {
    "appId": "app.opendraw.desktop",
    "productName": "OpenDraw",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist-electron/opendraw-mcp.mjs"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.graphics-design",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics"
    }
  }
}
