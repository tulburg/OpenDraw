{
  "name": "opendraw",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "vite build && bun scripts/build-electron.ts",
    "start": "bun run build && electron .",
    "typecheck": "tsc --noEmit",
    "test:launch": "bun run build && bun tests/launch.test.ts",
    "test:engine": "bun run build && bun tests/engine.test.ts",
    "test:mcp": "bun run build && bun tests/mcp.test.ts",
    "test": "bun run build && bun tests/launch.test.ts && bun tests/engine.test.ts && bun tests/mcp.test.ts && bun tests/write.test.ts && bun tests/canvas.test.ts && bun tests/styles.test.ts && bun tests/text.test.ts && bun tests/tools.test.ts",
    "test:write": "bun run build && bun tests/write.test.ts",
    "test:canvas": "bun run build && bun tests/canvas.test.ts",
    "test:styles": "bun run build && bun tests/styles.test.ts",
    "test:text": "bun run build && bun tests/text.test.ts",
    "test:tools": "bun run build && bun tests/tools.test.ts"
  },
  "trustedDependencies": [
    "electron"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "bin": {
    "opendraw-mcp": "dist-electron/opendraw-mcp.mjs"
  }
}
